# Unity 에디터 플러그인 자동 생성 파일
/[Aa]ssets/Plugins/Editor/JetBrains*

# IDE 및 빌드 캐시
.vs/
.gradle/
ExportedObj/
.consulo/

# 자동 생성 프로젝트 파일
*.csproj
*.unityproj
*.sln
*.suo
*.tmp
*.user
*.userprefs
*.pidb
*.booproj
*.svd
*.pdb
