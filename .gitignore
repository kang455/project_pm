# 자동 생성 파일의 meta
*.pidb.meta
*.pdb.meta
*.mdb.meta

# 로그 및 오류 보고서
*.log
sysinfo.txt
crashlytics-build.properties

# 빌드 및 패키지 결과
*.apk
*.aab
*.unitypackage
*.unitypackage.meta
*.app

# Addressables 자동 생성 데이터
/[Aa]ssets/[Aa]ddressable[Aa]ssets[Dd]ata/*/*.bin*
/[Aa]ssets/[Ss]treamingAssets/aa.meta
/[Aa]ssets/[Ss]treamingAssets/aa/*

# Python 가상환경
**/.venv/
**/venv/

# Python 캐시
**/__pycache__/
*.pyc
*.pyo
.pytest_cache/

# 행동 학습 중간 가중치
/.vscode/ActionLearning/*.pt
/.vscode/ActionLearning/reinforced/*.pt

# 시연 기록
SafetyDemonstrations/

# 로컬 비밀 설정
.env
.env.*
!.env.example